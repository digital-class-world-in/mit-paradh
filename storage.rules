rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // OPTION A: Development / Open Rules (Use if Firebase Auth is not active on client)
    match /{allPaths=**} {
      allow read, write: if true;
    }

    /* 
    // OPTION B: Production Rules (Requires Firebase Auth session)
    match /students/{studentId}/documents/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /staff_students/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /courses/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /colleges/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    */
  }
}
